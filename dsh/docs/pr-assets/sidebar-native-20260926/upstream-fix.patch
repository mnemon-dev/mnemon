+it('lists grouped bundle plugins without exposing native containers as components', async () => {
+  const { ctx, dir, manager, bundle } = await fixture('live', false, (ctx) => { ctx.loader.builtins.group = Group })
+  bundle('grouped', [{ id: 'group', name: 'cordis:group', group: true, config: [
+    { id: 'child', name: './plugin.mjs', config: { service: 'child' } },
+    { id: 'nested-group', name: 'cordis:group', group: true, config: [
+      { id: 'off-child', name: './plugin.mjs', disabled: true, config: { service: 'offChild' } },
+    ] },
+  ] }])
+  const patchPath = join(dir, 'node_modules', 'grouped', 'cordis.patch.yml')
+  const patches = JSON.parse(readFileSync(patchPath, 'utf8')) as PatchOptions[]
+  patches.push({ id: 'group', disabled: false }, { id: 'managed', config: { service: 'managedProbe' } })
+  writeFileSync(patchPath, JSON.stringify(patches))
+  const manifest = readProfileManifest('test', dir)
+  manifest.dependencies = { ...manifest.dependencies, grouped: '1.0.0' }
+  writeFileSync(join(dir, 'package.json'), JSON.stringify(manifest))
+  const moduleName = pathToFileURL(join(dir, 'node_modules', 'grouped', 'plugin.mjs')).href
+  const rows = [{ rowId: 'child', moduleName }, { rowId: 'off-child', moduleName }]
+  expect((await manager.listBundles()).find(row => row.name === 'grouped')).toMatchObject({ rows, overrides: ['managed'] })
+  expect(await manager.setBundleEnabled('grouped', true)).toMatchObject({ application: 'applied' })
+  expect((await manager.listBundles()).find(row => row.name === 'grouped')).toMatchObject({
+    rows: rows.map(row => ({ ...row, entryId: `include:${row.rowId}` })), overrides: ['managed'],
+  })
+  const plugins = await manager.listPlugins()
+  const child = plugins.find(row => row.patchId === 'child')!
+  expect(child.enabled).toBe(true)
+  expect(plugins.find(row => row.patchId === 'off-child')?.enabled).toBe(false)
+  expect(await manager.setPluginEnabled(child.entryId, false)).toMatchObject({ application: 'applied' })
+  expect(ctx.get('child')).toBeUndefined()
+  expect(await manager.setPluginEnabled(child.entryId, true)).toMatchObject({ application: 'applied' })
+  expect(ctx.get('child')).toBe(true)
+  expect(await manager.setBundleEnabled('grouped', false)).toMatchObject({ application: 'applied' })
+  expect(ctx.get('child')).toBeUndefined()
+  expect((await manager.listBundles()).find(row => row.name === 'grouped')).toMatchObject({ rows, overrides: ['managed'] })
+})
